{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "addLabels": [
        "automerge:off",
        "dependency-type:kubernetes-api"
      ],
      "automerge": false,
      "commitMessagePrefix": "feat(kubernetes-api)!:",
      "description": "update kubernetes-api versions",
      "matchDatasources": [
        "kubernetes-api"
      ],
      "minimumReleaseAge": "60 days",
      "semanticCommits": "disabled"
    },
    {
      "description": "configure version separation for kubernetes and flux versions. minor releases here can carry breaking changes, so patches are separated from minors as well: that keeps a patch on the current minor stream available as its own pull request instead of only ever being offered the next minor",
      "matchPackageNames": [
        "flux2",
        "fluxcd/flux2",
        "kindest/node",
        "kubectl",
        "kubernetes/kubectl",
        "kubernetes/kubernetes"
      ],
      "separateMajorMinor": true,
      "separateMinorPatch": true,
      "separateMultipleMajor": true,
      "separateMultipleMinor": true
    },
    {
      "automerge": false,
      "addLabels": [
        "automerge:off"
      ],
      "description": "disable automerge for major/minor updates of kubernetes and flux versions",
      "matchPackageNames": [
        "flux2",
        "fluxcd/flux2",
        "kindest/node",
        "kubectl",
        "kubernetes/kubectl",
        "kubernetes/kubernetes"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ]
    },
    {
      "description": "override release age for major/minor updates of flux versions",
      "matchPackageNames": [
        "flux2",
        "fluxcd/flux2"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "minimumReleaseAge": "30 days"
    },
    {
      "description": "override release age for major/minor updates of kubernetes versions",
      "matchPackageNames": [
        "kindest/node",
        "kubectl",
        "kubernetes/kubectl",
        "kubernetes/kubernetes"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "minimumReleaseAge": "60 days"
    },
    {
      "description": "group kubernetes updates by version",
      "groupName": "kubernetes",
      "matchPackageNames": [
        "kindest/node",
        "kubectl",
        "kubernetes/kubectl",
        "kubernetes/kubernetes"
      ]
    },
    {
      "description": "group flux updates by version",
      "groupName": "flux",
      "matchPackageNames": [
        "flux2",
        "fluxcd/flux2"
      ]
    }
  ]
}
