{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "addLabels": [
        "dependency-type:dev-tools"
      ],
      "commitMessageExtra": "({{#if isMajor}}major{{else}}non-major{{/if}})",
      "description": "update gomod/npm/pep621/poetry dependencies with a 7-day soak",
      "groupName": "{{manager}}-{{depType}}",
      "matchManagers": [
        "gomod",
        "npm",
        "pep621",
        "poetry"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "addLabels": [
        "dependency-type:dev-tools"
      ],
      "commitMessageExtra": "({{#if isMajor}}major{{else}}non-major{{/if}})",
      "commitMessagePrefix": "{{semanticCommitType}}{{#if semanticCommitScope}}({{semanticCommitScope}}){{/if}}:",
      "description": "update pre-commit dependencies with a 7-day soak",
      "groupName": "pre-commit",
      "matchManagers": [
        "pre-commit"
      ],
      "minimumReleaseAge": "7 days",
      "semanticCommitScope": "internal-dependencies",
      "semanticCommitType": "chore"
    },
    {
      "addLabels": [
        "dependency-type:dev-tools"
      ],
      "commitMessageExtra": "({{#if isMajor}}major{{else}}non-major{{/if}})",
      "description": "update bun/cargo/mise dependencies with a 7-day soak",
      "groupName": "{{manager}}",
      "matchManagers": [
        "bun",
        "cargo",
        "mise"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "addLabels": [
        "dependency-type:dev-tools"
      ],
      "description": "update language runtimes (bun/uv) with a 30-day soak",
      "matchPackageNames": [
        "astral-sh/uv",
        "bun",
        "oven-sh/bun",
        "uv"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "minimumReleaseAge": "30 days"
    },
    {
      "addLabels": [
        "dependency-type:dev-tools"
      ],
      "description": "update the go language runtime with a 90-day soak, in one group across every manager that pins it (each manager names it by its own packageName)",
      "groupName": "go",
      "matchPackageNames": [
        "go",
        "golang/go"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "minimumReleaseAge": "90 days"
    },
    {
      "addLabels": [
        "dependency-type:dev-tools"
      ],
      "description": "update the node language runtime with a 90-day soak, in one group across every manager that pins it (each manager names it by its own packageName)",
      "groupName": "node",
      "matchPackageNames": [
        "node",
        "nodejs"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "minimumReleaseAge": "90 days"
    },
    {
      "addLabels": [
        "dependency-type:dev-tools"
      ],
      "description": "update the python language runtime with a 90-day soak, in one group across every manager that pins it (each manager names it by its own packageName)",
      "groupName": "python",
      "matchPackageNames": [
        "python",
        "python/cpython"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "minimumReleaseAge": "90 days"
    },
    {
      "addLabels": [
        "dependency-type:dev-tools"
      ],
      "description": "update the rust language runtime with a 90-day soak, in one group across every manager that pins it (each manager names it by its own packageName)",
      "groupName": "rust",
      "matchPackageNames": [
        "rust",
        "rust-lang/rust"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "minimumReleaseAge": "90 days"
    },
    {
      "description": "update lockfiles",
      "groupName": "{{manager}} lockfile",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "semanticCommitScope": "internal-dependencies",
      "semanticCommitType": "chore",
      "schedule": [
        "every 14 day"
      ]
    },
    {
      "description": "update mise itself",
      "groupName": "mise",
      "matchPackageNames": [
        "jdx/mise"
      ],
      "minimumReleaseAge": "7 days",
      "semanticCommitScope": "internal-dependencies",
      "semanticCommitType": "chore"
    },
    {
      "description": "update renovate itself",
      "fetchChangeLogs": "off",
      "groupName": "renovate",
      "matchDatasources": [
        "docker",
        "github-releases",
        "npm"
      ],
      "matchPackageNames": [
        "npm:renovate",
        "renovate",
        "renovate/renovate",
        "renovatebot/renovate"
      ],
      "minimumReleaseAge": "7 days",
      "semanticCommitScope": "internal-dependencies",
      "semanticCommitType": "chore",
      "schedule": [
        "every 7 day"
      ]
    }
  ],
  "pre-commit": {
    "enabled": true
  }
}
